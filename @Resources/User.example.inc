; Personal settings for Control-Plaine. Copy to User.inc and edit.
; User.inc is not committed, so paths and preferences stay on your PC.

[Variables]
PlaynitePath=%LOCALAPPDATA%\Playnite\Playnite.DesktopApp.exe
; Time format on Day-Date hover: %#I:%M %p for 7:05 PM, %H:%M for 19:05.
TimeFormat=%#I:%M %p
; Volume change per scroll notch, in percent.
VolumeStep=2
; Uptime turns into a restart reminder after this many days.
UptimeWarnDays=5
