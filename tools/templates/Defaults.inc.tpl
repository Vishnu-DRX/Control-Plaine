; Control-Plaine | {{Name}}: setting defaults.
; The Settings window writes changes to @Resources\User.inc, which overrides these.
; Owned by the {{Name}} skin; add keys here with the {{Name}} prefix.

[Variables]
; Which screen edge the skin sits on: left puts the icon first, right mirrors
; it (label first, icon last). AlignAll in Settings can override it.
{{Name}}Align=left
; hover shows the label only while hovered, always keeps it visible.
; DetailsAll in Settings can override it.
{{Name}}Details=hover
; Colours for this skin: auto follows the global Theme, dark = white,
; light = black.
{{Name}}Theme=auto
; 1 shows this skin's tooltips, 0 hides them all.
{{Name}}Tooltips=1
