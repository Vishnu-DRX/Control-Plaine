; Control-Plaine layout, copied by tools\install.ps1 to %APPDATA%\Rainmeter\Layouts\Control-Plaine\Rainmeter.ini.
; Kept out of the skins tree and without an .ini name so Rainmeter does not list it as a skin.
; WindowX/Y are only a first column on the left of the primary screen at 100% (the order and
; sizes of Scripts\Placement.lua); the first-run setup's PLACEMENT step moves the skins to the
; screen and edge the user picks.
[Rainmeter]

[Control-Plaine\DayDate]
Active=1
WindowX=24
WindowY=24
ClickThrough=0
Draggable=1
SnapEdges=1
KeepOnScreen=1
AlwaysOnTop=0
AlphaValue=255

